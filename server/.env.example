# Copie este arquivo para server/.env e preencha os valores

PORT=3001
NODE_ENV=development
# Coloque 1 só se houver um proxy reverso na frente (Nginx, Render, Railway...).
# Sem proxy, deixe 0: senão o limite de envios pode ser burlado forjando o IP.
TRUST_PROXY=0
# Origem do front em desenvolvimento (para o CORS)
CLIENT_ORIGIN=http://localhost:5173

# MySQL: em produção use um usuário só com SELECT em projects e INSERT em messages
# (veja database/user.sql), nunca o root.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio

# SMTP (opcional). Se ficar vazio, as mensagens só são salvas no banco.
# Para Gmail, use uma "senha de app" (não a senha da conta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# E-mail que recebe o aviso de nova mensagem
CONTACT_TO=
